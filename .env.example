# Core Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URL
APP_URL=http://localhost:3000

# Invoice processing
# Safe zero-cost option for local/staging proof only. The application hard-blocks
# this synthetic fixture when VERCEL_ENV=production so fixture data can never become
# real production output.
AI_INVOICE_PROVIDER=fixture
ALLOW_SYNTHETIC_AI_FIXTURE=true

# Optional real external AI processing.
# Do not enable this by default: it requires an external provider account and may
# create usage costs. If explicitly chosen later, switch AI_INVOICE_PROVIDER to
# "openai" and configure both variables below server-side only.
# AI_INVOICE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_INVOICE_MODEL=
